--cpu Cortex-M3
"hw2-p1\startup_stm32f103xe.o"
"hw2-p1\main.o"
"hw2-p1\stm32f1xx_it.o"
"hw2-p1\stm32f1xx_hal_msp.o"
"hw2-p1\lcd.o"
"hw2-p1\stm32f1xx_hal_gpio_ex.o"
"hw2-p1\stm32f1xx_hal.o"
"hw2-p1\stm32f1xx_hal_rcc.o"
"hw2-p1\stm32f1xx_hal_rcc_ex.o"
"hw2-p1\stm32f1xx_hal_gpio.o"
"hw2-p1\stm32f1xx_hal_dma.o"
"hw2-p1\stm32f1xx_hal_cortex.o"
"hw2-p1\stm32f1xx_hal_pwr.o"
