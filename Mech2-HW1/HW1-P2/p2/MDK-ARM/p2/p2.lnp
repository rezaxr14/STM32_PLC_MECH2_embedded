--cpu Cortex-M3
"p2\startup_stm32f103xe.o"
"p2\main.o"
"p2\stm32f1xx_it.o"
"p2\stm32f1xx_hal_msp.o"
"p2\stm32f1xx_hal_gpio_ex.o"
"p2\stm32f1xx_hal.o"
"p2\stm32f1xx_hal_rcc.o"
"p2\stm32f1xx_hal_rcc_ex.o"
"p2\stm32f1xx_hal_gpio.o"
"p2\stm32f1xx_hal_dma.o"
"p2\stm32f1xx_hal_cortex.o"
"p2\stm32f1xx_hal_pwr.o"
"p2\stm32f1xx_hal_flash.o"
"p2\stm32f1xx_hal_flash_ex.o"
"p2\stm32f1xx_hal_exti.o"
"p2\system_stm32f1xx.o"
