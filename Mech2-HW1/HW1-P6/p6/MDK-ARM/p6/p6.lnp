--cpu Cortex-M3
"p6\startup_stm32f103xe.o"
"p6\main.o"
"p6\stm32f1xx_it.o"
"p6\stm32f1xx_hal_msp.o"
"p6\stm32f1xx_hal_gpio_ex.o"
"p6\stm32f1xx_hal.o"
"p6\stm32f1xx_hal_rcc.o"
"p6\stm32f1xx_hal_rcc_ex.o"
"p6\stm32f1xx_hal_gpio.o"
"p6\stm32f1xx_hal_dma.o"
"p6\stm32f1xx_hal_cortex.o"
"p6\stm32f1xx_hal_pwr.o"
