--cpu Cortex-M3
"hw1-p3\startup_stm32f103xe.o"
"hw1-p3\main.o"
"hw1-p3\stm32f1xx_it.o"
"hw1-p3\stm32f1xx_hal_msp.o"
"hw1-p3\stm32f1xx_hal_gpio_ex.o"
"hw1-p3\stm32f1xx_hal.o"
"hw1-p3\stm32f1xx_hal_rcc.o"
"hw1-p3\stm32f1xx_hal_rcc_ex.o"
"hw1-p3\stm32f1xx_hal_gpio.o"
"hw1-p3\stm32f1xx_hal_dma.o"
"hw1-p3\stm32f1xx_hal_cortex.o"
