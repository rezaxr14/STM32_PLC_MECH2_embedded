--cpu Cortex-M3
"p5\startup_stm32f103xe.o"
"p5\main.o"
"p5\stm32f1xx_it.o"
"p5\stm32f1xx_hal_msp.o"
"p5\stm32f1xx_hal_gpio_ex.o"
"p5\stm32f1xx_hal.o"
"p5\stm32f1xx_hal_rcc.o"
"p5\stm32f1xx_hal_rcc_ex.o"
"p5\stm32f1xx_hal_gpio.o"
"p5\stm32f1xx_hal_dma.o"
"p5\stm32f1xx_hal_cortex.o"
"p5\stm32f1xx_hal_pwr.o"
"p5\stm32f1xx_hal_flash.o"
"p5\stm32f1xx_hal_flash_ex.o"
"p5\stm32f1xx_hal_exti.o"
"p5\system_stm32f1xx.o"
--strict --scatter "p5\p5.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "p5.map" -o p5\p5.axf