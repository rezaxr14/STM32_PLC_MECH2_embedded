--cpu Cortex-M3
"hw4-p3-it\startup_stm32f103xe.o"
"hw4-p3-it\main.o"
"hw4-p3-it\stm32f1xx_it.o"
"hw4-p3-it\stm32f1xx_hal_msp.o"
"hw4-p3-it\stm32f1xx_hal_gpio_ex.o"
"hw4-p3-it\stm32f1xx_hal_uart.o"
"hw4-p3-it\stm32f1xx_hal.o"
"hw4-p3-it\stm32f1xx_hal_rcc.o"
"hw4-p3-it\stm32f1xx_hal_rcc_ex.o"
"hw4-p3-it\stm32f1xx_hal_gpio.o"
"hw4-p3-it\stm32f1xx_hal_dma.o"
"hw4-p3-it\stm32f1xx_hal_cortex.o"
"hw4-p3-it\stm32f1xx_hal_pwr.o"
"hw4-p3-it\stm32f1xx_hal_flash.o"
